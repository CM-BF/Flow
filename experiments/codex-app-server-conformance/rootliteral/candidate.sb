;; WPF-MATURE-02 proposal only. NOT EXECUTED, not a proven security boundary.
;; No system.sb import: that common profile grants broad metadata and home-related paths.
(version 1)
(deny default)
(deny network*)
(deny mach-lookup)
(deny process-fork)
;; Personal configuration and Keychain files are never canary targets.
(deny file-read* file-write*
  (subpath "/Users") (subpath "/var/root") (subpath "/private/var/root")
  (subpath "/Library/Keychains") (subpath "/private/var/db/DetachedSignatures")
  (subpath (param "DENY_ROOT")))

;; sandbox-exec installs the profile before exec. Only these two fixed binaries may exec.
;; This canary phase passes NODE only; CODEX remains NOT_RUN and requires separate review.
(allow process-exec
  (literal "/opt/homebrew/Cellar/node@24/24.20.0/bin/node")
  (literal "/opt/homebrew/lib/node_modules/@openai/codex/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex")
)

;; Child may read immutable control files and read/write only its dedicated state subtree.
(allow file-read* (subpath (string-append (param "ALLOW_ROOT") "/control")))
(allow file-read* file-write* (subpath (string-append (param "ALLOW_ROOT") "/state")))
;; Traversal metadata is narrow. No blanket file-read-metadata grant.
(allow file-read-metadata
  (literal "/") (literal "/private") (literal "/private/tmp")
  (literal (param "ALLOW_ROOT")))

;; Exact load names from local otool inspection; symlink and canonical names both retained.
(allow file-read* file-map-executable
  (literal "/System/Library/Frameworks/AppKit.framework/Versions/C/AppKit")
  (literal "/System/Library/Frameworks/CFNetwork.framework/Versions/A/CFNetwork")
  (literal "/System/Library/Frameworks/CoreFoundation.framework/Versions/A/CoreFoundation")
  (literal "/System/Library/Frameworks/CoreGraphics.framework/Versions/A/CoreGraphics")
  (literal "/System/Library/Frameworks/CoreServices.framework/Versions/A/CoreServices")
  (literal "/System/Library/Frameworks/Foundation.framework/Versions/C/Foundation")
  (literal "/System/Library/Frameworks/IOKit.framework/Versions/A/IOKit")
  (literal "/System/Library/Frameworks/Security.framework/Versions/A/Security")
  (literal "/System/Library/Frameworks/SystemConfiguration.framework/Versions/A/SystemConfiguration")
  (literal "/opt/homebrew/Cellar/brotli/1.2.0/lib/../lib/libbrotlicommon.1.dylib")
  (literal "/opt/homebrew/Cellar/brotli/1.2.0/lib/libbrotlicommon.1.2.0.dylib")
  (literal "/opt/homebrew/Cellar/brotli/1.2.0/lib/libbrotlidec.1.2.0.dylib")
  (literal "/opt/homebrew/Cellar/brotli/1.2.0/lib/libbrotlienc.1.2.0.dylib")
  (literal "/opt/homebrew/Cellar/c-ares/1.34.8/lib/libcares.2.19.7.dylib")
  (literal "/opt/homebrew/Cellar/hdrhistogram_c/0.11.10/lib/libhdr_histogram.6.3.3.dylib")
  (literal "/opt/homebrew/Cellar/icu4c@78/78.3/lib/libicudata.78.3.dylib")
  (literal "/opt/homebrew/Cellar/icu4c@78/78.3/lib/libicudata.78.dylib")
  (literal "/opt/homebrew/Cellar/icu4c@78/78.3/lib/libicui18n.78.3.dylib")
  (literal "/opt/homebrew/Cellar/icu4c@78/78.3/lib/libicuuc.78.3.dylib")
  (literal "/opt/homebrew/Cellar/icu4c@78/78.3/lib/libicuuc.78.dylib")
  (literal "/opt/homebrew/Cellar/libnghttp2/1.70.0/lib/libnghttp2.14.dylib")
  (literal "/opt/homebrew/Cellar/libnghttp3/1.18.0/lib/libnghttp3.9.9.0.dylib")
  (literal "/opt/homebrew/Cellar/libngtcp2/1.25.0/lib/libngtcp2.16.dylib")
  (literal "/opt/homebrew/Cellar/libuv/1.52.1/lib/libuv.1.0.0.dylib")
  (literal "/opt/homebrew/Cellar/node@24/24.20.0/bin/../lib/libnode.137.dylib")
  (literal "/opt/homebrew/Cellar/node@24/24.20.0/bin/node")
  (literal "/opt/homebrew/Cellar/node@24/24.20.0/lib/libnode.137.dylib")
  (literal "/opt/homebrew/Cellar/openssl@3/3.6.4/lib/libcrypto.3.dylib")
  (literal "/opt/homebrew/Cellar/openssl@3/3.6.4/lib/libssl.3.dylib")
  (literal "/opt/homebrew/Cellar/simdjson/4.6.11/lib/libsimdjson.33.0.0.dylib")
  (literal "/opt/homebrew/Cellar/sqlite/3.53.4/lib/libsqlite3.3.53.4.dylib")
  (literal "/opt/homebrew/Cellar/uvwasi/0.0.23/lib/libuvwasi.dylib")
  (literal "/opt/homebrew/Cellar/zstd/1.5.7_1/lib/libzstd.1.5.7.dylib")
  (literal "/opt/homebrew/lib/node_modules/@openai/codex/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex")
  (literal "/opt/homebrew/opt/brotli/lib/libbrotlicommon.1.dylib")
  (literal "/opt/homebrew/opt/brotli/lib/libbrotlidec.1.dylib")
  (literal "/opt/homebrew/opt/brotli/lib/libbrotlienc.1.dylib")
  (literal "/opt/homebrew/opt/c-ares/lib/libcares.2.dylib")
  (literal "/opt/homebrew/opt/hdrhistogram_c/lib/libhdr_histogram.6.dylib")
  (literal "/opt/homebrew/opt/icu4c@78/lib/libicudata.78.dylib")
  (literal "/opt/homebrew/opt/icu4c@78/lib/libicui18n.78.dylib")
  (literal "/opt/homebrew/opt/icu4c@78/lib/libicuuc.78.dylib")
  (literal "/opt/homebrew/opt/libnghttp2/lib/libnghttp2.14.dylib")
  (literal "/opt/homebrew/opt/libnghttp3/lib/libnghttp3.9.dylib")
  (literal "/opt/homebrew/opt/libngtcp2/lib/libngtcp2.16.dylib")
  (literal "/opt/homebrew/opt/libuv/lib/libuv.1.dylib")
  (literal "/opt/homebrew/opt/node@24/lib/libnode.137.dylib")
  (literal "/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib")
  (literal "/opt/homebrew/opt/openssl@3/lib/libssl.3.dylib")
  (literal "/opt/homebrew/opt/simdjson/lib/libsimdjson.33.dylib")
  (literal "/opt/homebrew/opt/sqlite/lib/libsqlite3.dylib")
  (literal "/opt/homebrew/opt/uvwasi/lib/libuvwasi.dylib")
  (literal "/opt/homebrew/opt/zstd/lib/libzstd.1.dylib")
  (literal "/usr/lib/dyld")
  (literal "/usr/lib/libSystem.B.dylib")
  (literal "/usr/lib/libbz2.1.0.dylib")
  (literal "/usr/lib/libc++.1.dylib")
  (literal "/usr/lib/libiconv.2.dylib")
  (literal "/usr/lib/liblzma.5.dylib")
  (literal "/usr/lib/libobjc.A.dylib")
  (literal "/usr/lib/libresolv.9.dylib")
  (literal "/usr/lib/libz.1.dylib")
)

;; The system shared-cache directory is the one intentionally broader read grant.
;; It contains OS runtime images; not all cached framework paths exist as standalone files.
;; This is a proposed bootstrap allowance, not observed startup necessity or successful enforcement.
(allow file-read* file-map-executable
  (subpath "/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld"))
;; No network, Mach service, keychain, sysctl, spawn, extension or no-sandbox allowances.

;; WPF-MATURE-02 fd canary candidate: the only grant added to the frozen profile.
;; Host binds CANARY_EXECUTABLE to its one compiled, hash-recorded owned binary.
(allow process-exec file-read* file-map-executable
  (literal (param "CANARY_EXECUTABLE")))

(allow system-mac-syscall (require-all (mac-policy-name "Sandbox") (mac-syscall-number 67)))

(allow file-read* file-test-existence (literal "/"))
