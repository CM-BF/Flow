(allow sysctl-read (sysctl-name "hw.pagesize_compat"))

;; Fixed absent system configuration seams; no directory data or recursive read grant.
(allow file-read-metadata file-test-existence
  (literal "/etc")
  (literal "/private/etc")
  (literal "/etc/codex")
  (literal "/private/etc/codex"))
(allow file-read-data file-read-metadata file-test-existence
  (literal "/etc/codex/requirements.toml")
  (literal "/etc/codex/config.toml")
  (literal "/etc/codex/managed_config.toml")
  (literal "/private/etc/codex/requirements.toml")
  (literal "/private/etc/codex/config.toml")
  (literal "/private/etc/codex/managed_config.toml"))
