;; The system shared-cache directory is the one intentionally broader read grant.
;; It contains OS runtime images; not all cached framework paths exist as standalone files.
;; This is a proposed bootstrap allowance, not observed startup necessity or successful enforcement.
(allow file-read* file-map-executable
  (subpath "/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld"))
;; No network, Mach service, keychain, sysctl, spawn, extension or no-sandbox allowances.


(allow system-mac-syscall (require-all (mac-policy-name "Sandbox") (mac-syscall-number 67)))

(allow file-read* file-test-existence (literal "/"))

