;; WPF-MATURE-02 proposal only. NOT EXECUTED, not a proven security boundary.
;; No system.sb import: that common profile grants broad metadata and home-related paths.
(version 1)
(deny default)
(deny network*)
(deny mach-lookup)
(deny process-fork)
;; Personal configuration and Keychain files are never canary targets.
(deny file-read* file-write*
  (subpath "/Users") (subpath "/var/root") (subpath "/private/var/root")
  (subpath "/Library/Keychains") (subpath "/private/var/db/DetachedSignatures")
  (subpath (param "DENY_ROOT")))

;; sandbox-exec installs the profile before exec. Only these two fixed binaries may exec.
;; This canary phase passes NODE only; CODEX remains NOT_RUN and requires separate review.
(allow process-exec
  (literal "/opt/homebrew/Cellar/node@24/24.20.0/bin/node")
  (literal "/opt/homebrew/lib/node_modules/@openai/codex/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex")
)

;; Child may read immutable control files and read/write only its dedicated state subtree.
(allow file-read* (subpath (string-append (param "ALLOW_ROOT") "/control")))
(allow file-read* file-write* (subpath (string-append (param "ALLOW_ROOT") "/state")))
;; Traversal metadata is narrow. No blanket file-read-metadata grant.
(allow file-read-metadata
  (literal "/") (literal "/private") (literal "/private/tmp")
  (literal (param "ALLOW_ROOT")))

;; Exact load names from local otool inspection; symlink and canonical names both retained.
(allow file-read* file-map-executable
  (literal "/System/Library/Frameworks/AppKit.framework/Versions/C/AppKit")
  (literal "/System/Library/Frameworks/CFNetwork.framework/Versions/A/CFNetwork")
  (literal "/System/Library/Frameworks/CoreFoundation.framework/Versions/A/CoreFoundation")
