# Local development only. Set a private owner token before starting the center.
DATABASE_URL=postgresql://flow:flow-local-only@127.0.0.1:55432/flow
FLOW_TOKEN=replace-with-a-long-random-owner-token
FLOW_PORT=4310
FLOW_ORIGIN=http://127.0.0.1:4311
FLOW_URL=http://127.0.0.1:4310
# Run the CLI runner registration command to obtain this one-time credential.
FLOW_RUNNER_TOKEN=
FLOW_RUNNER_WORKDIR=/tmp/flow-runner-workspace
