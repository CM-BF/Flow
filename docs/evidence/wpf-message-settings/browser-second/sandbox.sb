(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/msgset-b2/scratch") (subpath "/private/tmp/msgset-b2/raw/settings-b2-20261006-191743-60f52b") (literal "/dev/null"))
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(allow network-bind (prefix "/private/tmp/msgset-b2/scratch/"))
(allow network-outbound (prefix "/private/tmp/msgset-b2/scratch/"))
