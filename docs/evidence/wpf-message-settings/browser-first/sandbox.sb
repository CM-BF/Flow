(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/message-settings-browser-candidate/scratch") (subpath "/private/tmp/message-settings-browser-candidate/raw/settings-20261006-185753-21f4e5") (literal "/dev/null"))
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
