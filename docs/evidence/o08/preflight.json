  "tools": [
    {
      "name": "graph_read",
      "description": "Read the fixed base graph in bounded pages, or fetch this grant's saved proposal text by id. Nodes are id/title/version; currentRevision and stale describe freshness without replacing the base. No history is appended. Whole-base graph is readable; existing-node write references remain scoped.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "view": {
                    "type": "string",
                    "const": "graph"
                  },
                  "after": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "limit": {
                    "default": 20,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  }
                },
                "required": [
                  "view"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "view": {
                    "type": "string",
                    "const": "proposal"
                  },
                  "proposalId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "view",
                  "proposalId"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "request"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "graph_command",
      "description": "Propose or apply a bounded graph within the fixed grant. Retain the same idempotencyKey for the same intent after an unknown outcome. Apply names the returned proposal id, digest and baseRevision. No child execution or engineering writes are supported. The center validates quota, current authority and versions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "propose"
                  },
                  "proposal": {
                    "type": "object",
                    "properties": {
                      "expectedProjectRevision": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "additions": {
                        "minItems": 1,
                        "maxItems": 16,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "key": {
                              "type": "string",
                              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$"
                            },
                            "title": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 180
                            },
                            "dependencies": {
                              "maxItems": 128,
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "object",
                                    "properties": {
                                      "kind": {
                                        "type": "string",
                                        "const": "proposed"
                                      },
                                      "key": {
                                        "type": "string",
                                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$"
                                      }
                                    },
                                    "required": [
                                      "kind",
                                      "key"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "kind": {
                                        "type": "string",
                                        "const": "existing"
                                      },
                                      "nodeId": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 128
                                      },
                                      "expectedVersion": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 2147483647
                                      }
                                    },
                                    "required": [
                                      "kind",
                                      "nodeId",
                                      "expectedVersion"
                                    ],
                                    "additionalProperties": false
                                  }
                                ]
                              }
                            }
                          },
                          "required": [
                            "key",
                            "title",
                            "dependencies"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "expectedProjectRevision",
                      "reason",
                      "additions"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "kind",
                  "proposal"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "apply"
                  },
                  "proposalId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "expectedProjectRevision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "proposalDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "proposalId",
                  "expectedProjectRevision",
                  "proposalDigest"
                ],
                "additionalProperties": false
              }
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "command",
          "idempotencyKey"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
