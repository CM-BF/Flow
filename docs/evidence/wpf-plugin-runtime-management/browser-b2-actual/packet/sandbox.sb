(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/prm-b2/scratch") (subpath "/private/tmp/prm-b2/raw/plugin-b2-20261007-124936-c6dcf5") (literal "/dev/null"))
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
