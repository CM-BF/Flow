(version 1)
(deny default)
(deny process-fork)
(deny network*)
(deny mach-lookup)
(allow process-exec (literal "/opt/homebrew/lib/node_modules/@openai/codex/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex"))
(allow file-read* file-map-executable (literal "/opt/homebrew/lib/node_modules/@openai/codex/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex"))
(allow file-read* (subpath "/private/tmp/eng01j-helper-qvdsk3z0"))
(allow file-read-metadata (literal "/private/tmp/eng01j-helper-qvdsk3z0") (literal "/private/tmp") (literal "/private") (literal "/"))
(allow file-read* file-map-executable
  (subpath "/usr/lib") (subpath "/System/Library")
  (subpath "/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld"))
(allow file-read* file-test-existence (literal "/"))
(allow system-mac-syscall (require-all (mac-policy-name "Sandbox") (mac-syscall-number 67)))
(allow file-write-data (literal "/private/tmp/eng01j-helper-qvdsk3z0/calculator.mjs"))
