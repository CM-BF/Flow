(version 1)
(deny default)
(deny process-fork)
(deny network*)
(deny mach-lookup)
(allow process-exec (literal "/private/tmp/eng01j-helper-d16yhlmq/page-size"))
(allow file-read* file-map-executable (literal "/private/tmp/eng01j-helper-d16yhlmq/page-size"))
(allow file-read* (subpath "/private/tmp/eng01j-helper-d16yhlmq"))
(allow file-read-metadata (literal "/private/tmp/eng01j-helper-d16yhlmq") (literal "/private/tmp") (literal "/private") (literal "/"))
(allow file-read* file-map-executable
  (subpath "/usr/lib") (subpath "/System/Library")
  (subpath "/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld"))
(allow file-read* file-test-existence (literal "/"))
(allow system-mac-syscall (require-all (mac-policy-name "Sandbox") (mac-syscall-number 67)))
(allow file-write-data (literal "/private/tmp/eng01j-helper-d16yhlmq/calculator.mjs"))
(allow sysctl-read (sysctl-name "hw.pagesize"))
