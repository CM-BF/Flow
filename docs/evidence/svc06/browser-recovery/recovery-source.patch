+  if (!value || Object.keys(value).sort().join() !== keys.sort().join() || !isAbsolute(value.directory ?? '')
+    || !uuid.test(value.operationId ?? '') || !uuid.test(value.requestId ?? '')
+    || !Number.isSafeInteger(value.expectedVersion) || value.expectedVersion < 1
