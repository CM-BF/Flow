(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/rel01-c2/scratch") (subpath "/private/tmp/rel01-c2/raw/release01-c2-20261007-114405-6b2284") (literal "/dev/null"))
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(deny network-outbound (remote ip "127.0.0.1:61228"))
