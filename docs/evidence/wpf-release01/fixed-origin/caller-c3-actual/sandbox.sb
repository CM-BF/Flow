(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/rel01-c3/scratch") (subpath "/private/tmp/rel01-c3/raw/release01-c3-20261007-115305-4777b7") (literal "/dev/null"))
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(deny network-outbound (remote ip "localhost:61228"))
