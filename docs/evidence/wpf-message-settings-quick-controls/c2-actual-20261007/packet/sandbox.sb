(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/msgquick-checks-c2/scratch") (literal "/dev/null"))
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
