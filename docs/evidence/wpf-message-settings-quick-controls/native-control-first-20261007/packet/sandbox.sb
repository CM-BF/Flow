(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/msgquick-native1/scratch") (subpath "/private/tmp/msgquick-native1/raw/msgquick-native1-20261007-060926-18698b") (literal "/dev/null"))
(deny network*)
