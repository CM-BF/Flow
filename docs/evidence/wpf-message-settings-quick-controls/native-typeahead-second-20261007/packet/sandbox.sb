(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/msgquick-typeahead2/scratch") (subpath "/private/tmp/msgquick-typeahead2/raw/msgquick-typeahead2-20261007-071813-2f26da") (literal "/dev/null"))
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
