(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/msgquick-native2/scratch") (subpath "/private/tmp/msgquick-native2/raw/msgquick-native2-20261007-062946-51fcb2") (literal "/dev/null"))
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
