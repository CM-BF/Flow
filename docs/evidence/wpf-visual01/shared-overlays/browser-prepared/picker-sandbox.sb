(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/vis-picker-b1/scratch") (subpath "/private/tmp/vis-picker-b1/raw/ADMISSION_RUN_ID") (literal "/dev/null"))
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
