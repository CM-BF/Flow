(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/connection-ux-b1/scratch") (subpath "/private/tmp/connection-ux-b1/raw") (literal "/dev/null"))
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
