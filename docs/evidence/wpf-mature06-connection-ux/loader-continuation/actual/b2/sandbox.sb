(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/connection-ux-b2/scratch") (subpath "/private/tmp/connection-ux-b2/raw/connection-loader-20261008-e9df81b8") (literal "/dev/null"))
(deny network*)
